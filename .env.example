# Cliente público de Supabase. Nunca pongas aquí service_role ni una clave secreta.
SUPABASE_URL=https://ktgogijxtsidctkidrav.supabase.co
SUPABASE_ANON_KEY=pega_aqui_la_clave_anon_public

# OAuth de Google de escritorio (se mantiene fuera del repositorio).
SISTEMA_GOOGLE_CREDENTIALS=C:\ruta\segura\credentials.json

# ID de la hoja principal del sistema; si se borra, la app crea otra automáticamente.
SISTEMA_SPREADSHEET_ID=

# IA generativa local opcional. No se envían expedientes a servicios externos.
SISTEMA_OLLAMA_URL=http://127.0.0.1:11434
SISTEMA_OLLAMA_MODEL=qwen2.5:7b
SISTEMA_OLLAMA_TIMEOUT=180
# Opcional: manifiesto HTTPS firmado/verificable para una futura actualización.
SISTEMA_OLLAMA_MANIFEST_URL=
